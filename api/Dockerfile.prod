# Image de production : binaire compilé (le Dockerfile de dev utilise air et un volume).
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

FROM alpine:3.20
WORKDIR /app
COPY --from=build /out/api ./api
# Les migrations sont lues au démarrage depuis file://migrations (relatif au dossier courant).
COPY migrations ./migrations
EXPOSE 4000
CMD ["./api"]
